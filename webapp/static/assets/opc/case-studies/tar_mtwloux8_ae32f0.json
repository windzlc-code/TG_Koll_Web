RvLkMzIn0%3D&_nc_ohc=HD2HGjfcNrYQ7kNvwFUKxkx&_nc_oc=AdoMUE_e21SY95s3y-ugcoIvUvBGN_cqI4PbjJjAh9QGCArpmyFFNPC-BamEWkAb5qE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin6-3.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQLlayzeDzNaThFrn7-isHZyfaVLPhajjfOEaiHAc5jPHQ&oe=6AA9F0DF"],"mediaItems":[{"type":"image","url":"https://scontent-sin6-3.cdninstagram.com/v/t51.82787-15/799347096_18095752133180805_2724200824310695469_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=106&ig_cache_key=Mzk4MDg5Mzk2MzAyNDUzMDA5Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuOTY5LnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=HD2HGjfcNrYQ7kNvwFUKxkx&_nc_oc=AdoMUE_e21SY95s3y-ugcoIvUvBGN_cqI4PbjJjAh9QGCArpmyFFNPC-BamEWkAb5qE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin6-3.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQLlayzeDzNaThFrn7-isHZyfaVLPhajjfOEaiHAc5jPHQ&oe=6AA9F0DF"}],"likes":71,"replies":15,"reposts":0,"quotes":0,"views":0,"engagement":86},{"url":"https://www.threads.com/@mirahuang.12/post/Dc7uy-hkh2x","publishedAt":"2026-09-06T04:57:50.000Z","text":"上次陪好友去見脆友，昨天他們又約了，然後我又被叫去了\n\n先回答一下留言，我好友是男生，對方是女生。我原本以為第二次應該沒我的事，結果出門前又收到他的訊息，問我可不可以一起\n\n我：你們不是已經見過了\n他：有妳比較不尷尬\n\n好，我就再陪一次\n\n剛坐下的時候確實還是三個人一起聊，後來他們講到上次聊過的事，越聊越順。我有幾段根本不知道前情，索性低頭吃我的東西\n\n他中間終於想起我，轉過來問我怎麼都沒講話\n\n我：你不是怕尷尬才叫我來嗎，我看現在很好啊\n\n女生聽完笑了，他倒是突然不知道要回什麼\n\n其實看他們聊得起來，我也滿開心的。只是下次如果又找我，我要先看餐廳，畢竟你們有話聊，我至少要有東西好好吃😂","media":["https://scontent-sin6-2.cdninstagram.com/v/t51.82787-15/798589763_18095295185180805_3102115800833524338_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=109&ig_cache_key=Mzk3OTk4MDUwODk2MDUyOTg0MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMzAwMC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=haCHHMJPdbcQ7kNvwH47I9O&_nc_oc=AdoVAO4LY9qdo5ojEQwXlV4Xf9n6kGBSM7XdWIZN50UkW1baW8y0ecopSd8TCHLwNSA&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin6-2.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQL0J-JruWcrm9P7yMyNVm8-lYivOV5KVguJyLitpCtITQ&oe=6AA9FE91"],"mediaItems":[{"type":"image","url":"https://scontent-sin6-2.cdninstagram.com/v/t51.82787-15/798589763_18095295185180805_3102115800833524338_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=109&ig_cache_key=Mzk3OTk4MDUwODk2MDUyOTg0MQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMzAwMC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=haCHHMJPdbcQ7kNvwH47I9O&_nc_oc=AdoVAO4LY9qdo5ojEQwXlV4Xf9n6kGBSM7XdWIZN50UkW1baW8y0ecopSd8TCHLwNSA&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin6-2.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQL0J-JruWcrm9P7yMyNVm8-lYivOV5KVguJyLitpCtITQ&oe=6AA9FE91"}],"likes":26,"replies":7,"reposts":0,"quotes":0,"views":0,"engagement":33},{"url":"https://www.threads.com/@mirahuang.12/post/Dc5j2rhEu6h","publishedAt":"2026-09-05T08:43:44.000Z","text":"現在做指甲，都直接跟美甲師說只做護理就好\n坐著喝咖啡看自己的手，覺得這樣素素的也蠻順眼\n\n以前每次預約前都會存一堆圖，選顏色、挑款式，偶爾還想加點小裝飾。常常到了現場都還在猶豫\n\n跟老闆工作久了，才慢慢摸到他的喜好\n幾次一起挑東西，他都選最簡單的那個，連簡報上多加的裝飾，也常被他說拿掉就好\n\n有一次拿資料給他，他看了一下我的指甲\n\n老闆：這樣打字不會卡嗎\n我：不會啊 很可愛吧\n老闆：我覺得乾乾淨淨的就很好看了\n\n我當時還覺得他完全不懂\n這個款式我可是挑了很久欸\n\n後來有次卸掉美甲，還沒接著做新的，他反而說這樣比較好看\n\n他也沒叫我改，但那幾句話我倒是記得蠻清楚的。後來想說先維持這樣看看，結果自己也越看越習慣\n\n現在都只做護理，把指甲修整齊、手顧好就好\n不用再花時間選款式，也真的省下一筆\n\n本來只是試試看\n現在反而沒那麼想把那些裝飾加回去了","media":["https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/797743351_18094986434180805_5800179478516599234_n.webp?_nc_cat=100&ig_cache_key=Mzk3OTM2OTQzNDk2Mzk2MzU1Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuOTQxLnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=GpsrDLu8Zc0Q7kNvwGVQrBK&_nc_oc=AdpoWjjiFhzy0af8SbkfZ-9eVs7bvcFbNPJxOhAXmPTu4ZW6rpdNBM_zt64_dzZo1oE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQI0Wro0U_O7wtOU4jZrzuZHd9Sn-1FUg1WV7XUjOCV5KA&oe=6AAA1866"],"mediaItems":[{"type":"image","url":"https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/797743351_18094986434180805_5800179478516599234_n.webp?_nc_cat=100&ig_cache_key=Mzk3OTM2OTQzNDk2Mzk2MzU1Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuOTQxLnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=GpsrDLu8Zc0Q7kNvwGVQrBK&_nc_oc=AdpoWjjiFhzy0af8SbkfZ-9eVs7bvcFbNPJxOhAXmPTu4ZW6rpdNBM_zt64_dzZo1oE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQI0Wro0U_O7wtOU4jZrzuZHd9Sn-1FUg1WV7XUjOCV5KA&oe=6AAA1866"}],"likes":29,"replies":15,"reposts":0,"quotes":0,"views":0,"engagement":44},{"url":"https://www.threads.com/@mirahuang.12/post/Dc5ARnbkier","publishedAt":"2026-09-05T03:32:51.000Z","text":"昨天跟老闆去台中，晚上才搭車回來\n今天醒來看了一下時間 決定早餐午餐一起吃就好\n\n本來想趁出門吃飯前，把昨天的會議紀錄整理一下\n就先傳訊息跟老闆說晚一點給他\n\n老闆：星期一再給我就好\n我：你今天沒在忙喔\n老闆：剛運動完 準備吃飯\n我：你不累嗎\n老闆：還好 妳才剛起床？\n我：我現在準備吃早餐\n老闆：午餐吧\n\n好 不用糾正得那麼快\n\n明明昨天一起跑行程、一起搭車回來\n我現在連吃什麼都還沒決定，他已經運動完了\n\n平常幫他排行程，總覺得自己很清楚他一天在做什麼\n結果放假之後才發現 我好像只知道他上班的樣子\n\n本來還想問他到底幾點起床\n想想先不要 我怕問到最後又變成下次一起去運動😂\n\n至於資料星期一再給這句\n我有聽進去 今天先好好吃飯","media":["https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/797903900_18094925654180805_7082743006194559063_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ig_cache_key=Mzk3OTIxMjk1NjMyODE0Mjc2Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTEzNC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=75Fn0XDpveMQ7kNvwEHSRIE&_nc_oc=AdpbC8flxCo6MfpO_zij39oOBaJTnfjBvm1y9sZA3tv6Tjo2XzwU1X5LRgawik9u4jw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQI5sHbrppRa3930HGQShN8sZvYN2hAS3ELLxy5HyjnG3Q&oe=6AAA0700"],"mediaItems":[{"type":"image","url":"https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/797903900_18094925654180805_7082743006194559063_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ig_cache_key=Mzk3OTIxMjk1NjMyODE0Mjc2Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTEzNC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=75Fn0XDpveMQ7kNvwEHSRIE&_nc_oc=AdpbC8flxCo6MfpO_zij39oOBaJTnfjBvm1y9sZA3tv6Tjo2XzwU1X5LRgawik9u4jw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQI5sHbrppRa3930HGQShN8sZvYN2hAS3ELLxy5HyjnG3Q&oe=6AAA0700"}],"likes":47,"replies":9,"reposts":0,"quotes":0,"views":0,"engagement":56},{"url":"https://www.threads.com/@mirahuang.12/post/Dc3o1zpkjtz","publishedAt":"2026-09-04T14:48:50.000Z","text":"今天跟老闆到台中半日出差，本來以為下午就能回去，結果事情結束的時候已經晚上了。\n\n到車站才發現最近一班沒位置，只剩商務座。我還在看要不要等下一班，老闆已經把卡拿出來了。\n\n我：下一班還有一般座\n老闆：妳想等？\n我：也不是\n老闆：那就走\n\n然後直接刷了兩張。\n\n我站在旁邊愣了一下。這個人只要不想等，好像價差都不是問題。\n\n上車之後他又把電腦打開看資料，我本來也想整理今天的會議紀錄，結果一坐下突然覺得自己真的有點累。\n\n老闆：妳不是說不用坐商務座\n我：我現在收回\n老闆：晚了\n\n……好喔\n\n半日出差一路拖到晚上，能早一班回家真的差很多。\n\n現在坐在這裡\n突然覺得他剛剛那張卡\n刷得還蠻有道理的","media":["https://scontent-sin11-2.cdninstagram.com/v/t51.82787-15/793626415_18094756466180805_4203724337972562232_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=101&ig_cache_key=Mzk3ODgyODQxNTI1NjExNjA4Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTEwOS5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=zvu5sEYs7i4Q7kNvwEDbnug&_nc_oc=AdoMchzCzD0JOu96Zh7jI-sK3NworkUfmu0FDuIdE_msb6i8DrqInUG7_WPA-5Okd10&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin11-2.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQJIQZ4-1P_8-Od-YAT_ZWu1LSm1kWF4b1RGALZG5xVKYA&oe=6AAA15AB"],"mediaItems":[{"type":"image","url":"https://scontent-sin11-2.cdninstagram.com/v/t51.82787-15/793626415_18094756466180805_4203724337972562232_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=101&ig_cache_key=Mzk3ODgyODQxNTI1NjExNjA4Mw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTEwOS5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=zvu5sEYs7i4Q7kNvwEDbnug&_nc_oc=AdoMchzCzD0JOu96Zh7jI-sK3NworkUfmu0FDuIdE_msb6i8DrqInUG7_WPA-5Okd10&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin11-2.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQJIQZ4-1P_8-Od-YAT_ZWu1LSm1kWF4b1RGALZG5xVKYA&oe=6AAA15AB"}],"likes":76,"replies":15,"reposts":0,"quotes":0,"views":0,"engagement":91},{"url":"https://www.threads.com/@mirahuang.12/post/Dc2LazsklKN","publishedAt":"2026-09-04T01:12:30.000Z","text":"有一天一早等廠商來公司拜訪老闆，比約定時間早到了一點。\n\n老闆還在忙，我先下來透透氣。剛好陽光很好，就順手拍了一張。\n\n回去的時候他抬頭問我\n\n老闆：妳剛剛去哪\n我：拍照啊\n老闆：我以為妳去確認會議室\n我：昨天就確認好了\n老闆：資料呢\n我：也好了\n\n他安靜了兩秒...\n\n老闆：所以真的只是去拍照\n我：不然呢\n\n特助把事情先做好\n就不能順便拍一下嗎\n\n後來要進去之前，他又突然說了一句\n\n老闆：拍得還可以\n\n我看了他一下\n他已經低頭繼續看資料了\n\n好吧\n\n雖然只有「還可以」\n但從老闆嘴裡聽到\n好像已經算很高分了","media":["https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/793721392_18094564370180805_7803361778296541891_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=100&ig_cache_key=Mzk3ODQxNzU0MTU1NTA0OTEwMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTAyMy5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=varwWcoGIg8Q7kNvwG5pfQN&_nc_oc=AdqeUQ9Tt0Dy9Lsc17wr34B9XrHqLmWF8oHfYgZKmJxTPNzysJhrbNZG6DplkZiydSE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQIrN-EryrysQ8pCOBXnGy8955A2Du98oUVn9l00kTnlfw&oe=6AAA0E09"],"mediaItems":[{"type":"image","url":"https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/793721392_18094564370180805_7803361778296541891_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=100&ig_cache_key=Mzk3ODQxNzU0MTU1NTA0OTEwMQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTAyMy5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=varwWcoGIg8Q7kNvwG5pfQN&_nc_oc=AdqeUQ9Tt0Dy9Lsc17wr34B9XrHqLmWF8oHfYgZKmJxTPNzysJhrbNZG6DplkZiydSE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQIrN-EryrysQ8pCOBXnGy8955A2Du98oUVn9l00kTnlfw&oe=6AAA0E09"}],"likes":41,"replies":27,"reposts":0,"quotes":0,"views":0,"engagement":68},{"url":"https://www.threads.com/@mirahuang.12/post/Dc0zC80ErEN","publishedAt":"2026-09-03T12:20:17.000Z","text":"桃園今天從早下到晚，上班一整天都覺得灰灰濕濕的。晚上跟老闆結束最後一個行程，我只想趕快回家。\n\n結果經過春日路，看到國泰置地廣場裡面的 MUJI 居然已經點燈了。\n\n我：老闆 等一下\n老闆：怎麼了\n我：MUJI點燈了\n老闆：它還沒開\n我：我知道啊 但已經點燈了\n老闆：……所以呢\n我：看一下\n老闆：還沒開 妳在開心什麼\n我：就是快開了才開心啊\n老闆：所以這個也要排進行程？\n我：不用啦\n他看了我一眼，說我今天開會都沒這麼有精神。\n\n好 我承認\n\n今天雨下到整個人都有點悶悶的，但看到那個招牌亮起來，真的有突然清醒一下，而且裡面看起來也弄得差不多了。\n\n老闆嘴上說還沒開有什麼好看，最後還是站在旁邊等我拍完這張。\n\n突然覺得以後春日路附近的行程\n我應該都會很願意陪他去","media":["https://scontent-sin6-3.cdninstagram.com/v/t51.82787-15/792695078_18094384232180805_8759012142427508516_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=110&ig_cache_key=Mzk3ODAyODg2NjQzNDQxMjg0Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTY2OC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=3KgygV__zYUQ7kNvwF0c8m-&_nc_oc=AdqIUlJFEeeLO-WUj4AHOaO-vub55MSFtY-BMWRASPxWt4My7PEfNG4fORMkbaoZ5tk&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin6-3.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQJSirYCzhuyecW_T1HKgbKpR7iSg8RRhkOOGE2BcyQ5vQ&oe=6AA9EDCE","https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/793121838_18094384247180805_6766686593150020792_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ig_cache_key=Mzk3ODAyODg2NjIzMzA5NDQ0NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMjMwNC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=ihyiMcKxXaMQ7kNvwFHOdSn&_nc_oc=AdoW1L-UjtRHpHOG0fFwSyO6tYivAAL2Ljk-j_jbh745k6ZiZQyfuZZhyPyASzoAaC8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQKYw9Zo2YqrevtH_a6GlZhCoGDKPVOkKfb7PdqLjbxusw&oe=6AA9F9E5"],"mediaItems":[{"type":"image","url":"https://scontent-sin6-3.cdninstagram.com/v/t51.82787-15/792695078_18094384232180805_8759012142427508516_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=110&ig_cache_key=Mzk3ODAyODg2NjQzNDQxMjg0Ng%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTY2OC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=3KgygV__zYUQ7kNvwF0c8m-&_nc_oc=AdqIUlJFEeeLO-WUj4AHOaO-vub55MSFtY-BMWRASPxWt4My7PEfNG4fORMkbaoZ5tk&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin6-3.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQJSirYCzhuyecW_T1HKgbKpR7iSg8RRhkOOGE2BcyQ5vQ&oe=6AA9EDCE"},{"type":"image","url":"https://scontent-sin2-1.cdninstagram.com/v/t51.82787-15/793121838_18094384247180805_6766686593150020792_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ig_cache_key=Mzk3ODAyODg2NjIzMzA5NDQ0NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMjMwNC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=ihyiMcKxXaMQ7kNvwFHOdSn&_nc_oc=AdoW1L-UjtRHpHOG0fFwSyO6tYivAAL2Ljk-j_jbh745k6ZiZQyfuZZhyPyASzoAaC8&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-1.cdninstagram.com&_nc_gid=gYTyriJqWdFV5fftZgiztg&_nc_ss=7a22e&oh=00_AQKYw9Zo2YqrevtH_a6GlZhCoGDKPVOkKfb7PdqLjbxusw&oe=6AA9F9E5"}],"likes":49,"replies":6,"reposts":0,"quotes":0,"views":0,"engagement":55},{"url":"https://www.threads.com/@mirahuang.12/post/Dcz58XmkkLW","publishedAt":"2026-09-03T04:01:19.000Z","text":"今天在運動的時候，突然想到一件事。\n\n我以前根本不會主動運動\n會開始 好像完全是因為老闆\n\n跟著他跑行程之後，我才發現他只要兩個會議中間有空，就會去健身房。\n\n第一次陪他去，我本來想坐在外面回訊息，順便幫他看時間。\n\n老闆：妳要不要一起\n我：不用啊 我在外面等你就好\n老闆：妳每次都坐著等不無聊\n我：我可以處理工作\n老闆：妳每次都有工作\n我：……不然我是來做什麼的\n\n他聽完也沒多說，直接去櫃檯幫我辦會員，然後刷卡。\n\n我站在旁邊愣了一下\n\n想說這到底算工作福利\n還是他真的看不下去我每次只坐著等\n\n後來只要行程中間有空，我就會跟著他動一下。從一開始只是覺得會員不要浪費，到現在沒有跟著老闆，也會自己把墊子拿出來。\n\n有點不想承認\n但這個習慣好像真的是他帶出來的","media":["https://scontent-sin2-3.cdninstagram.com/v/t51.82787-15/791906476_18094270334180805_272774864438807369_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=107&ig_cache_key=Mzk3Nzc3NzczMzA2MTE5ODU1MA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuOTc0LnNkci5yZWd1bGFyX3Bob3RvLkMzIn0%3D&_nc_ohc=uok0BVKXsOcQ7kNvwF8vffk&_nc_oc=AdpkibXvrox4-cGuEnrJcyn8KY7ER-ZFhHVVHDhUMzZf5wZ6BUogxwX5N6GHJ5DCnxw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-sin2-3.cdninstagram.com&_nc_gid=LfZygGjqmrnOy6F8wkuDIw&_nc_ss=7a22e&oh=00_AQKXubzS-jjR1eA3HoZbMqBcTTZ2Lj08cW4m_P2O2CVN7w&oe=6AAA0353"],"mediaItems":[{"type":"image","url":"https://scontent-sin2-3.cdninstagram.com/v/t51.82787-15/791906476_18094270334180805_272774864438807369_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=107&ig_cache_key=Mzk3Nzc3NzczMzA2MTE5ODU1MA%3D%3D.3-ccb7-5&ccb=7-5&_nc